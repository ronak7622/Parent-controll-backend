# ===== Child Protect Backend — Environment Configuration =====
# Copy to .env and fill REAL values. .env is gitignored — never commit secrets.

# ---- Core ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local dev: mongodb://localhost:27017/child_protect_db
# Production: your OVH Mongo box (separate server) connection string
MONGODB_URI=mongodb://localhost:27017/child_protect_db

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_secret

# ---- Redis (REQUIRED for horizontal scaling: Socket.IO adapter, BullMQ, rate-limit, cache) ----
# Local dev: redis://localhost:6379   | Production: your Redis URL
REDIS_URI=redis://localhost:6379

# ---- Cloudflare R2 (media storage; zero egress) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=child-protect-media
R2_PUBLIC_DOMAIN=
# Optional CDN domain in front of R2 (defaults to R2_PUBLIC_DOMAIN)
CDN_PUBLIC_DOMAIN=

# ---- Firebase Admin (FCM push). Paste the FULL service-account JSON on one line. ----
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ---- SMS / OTP provider ----
SMS_PROVIDER=MSG91
SMS_PROVIDER_API_KEY=
MSG91_TEMPLATE_ID=

# ---- Tunables ----
SUBSCRIPTION_SCAN_MS=60000

# ---- Scalability feature flags (opt-in) ----
ENABLE_PRESIGNED_UPLOADS=true
ENABLE_BULLMQ_INGEST=false
ENABLE_REDIS_CACHE=false
ENABLE_TTL_INDEXES=false
ENABLE_READ_REPLICAS=false

# ---- Mongo backup -> R2 (used by scripts/backup-mongo.sh) ----
# Defaults reuse R2_* above; override bucket/prefix/retention if needed.
BACKUP_R2_BUCKET=
BACKUP_PREFIX=backups/mongo
BACKUP_RETENTION_DAYS=14

# ---- Cloudflare TURN (live WebRTC relay) ----
# NOTE: TURN ICE credentials are consumed by the CHILD/PARENT apps via Firebase Remote Config,
# not by this backend. If you later add a backend endpoint that mints short-lived Cloudflare
# TURN credentials, store the token here:
# CLOUDFLARE_TURN_TOKEN_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# ---- Razorpay (Web Payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Play (App In-App Billing) ----
GOOGLE_PLAY_PACKAGE_NAME=com.parentprotect.parent_app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_VERIFICATION_TOKEN=
