# Child Protect Backend Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/child_protect_db

# JWT Secret for Parent App Authentication
JWT_SECRET=super_secret_jwt_key_child_protect_2026

# Cloudflare R2 / AWS S3 Storage Settings (Zero-Egress Download Fees)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=child-protect-media
R2_PUBLIC_DOMAIN=https://media.childprotect.app

# Firebase Admin SDK (For sending 100% free unlimited FCM Push Commands)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
